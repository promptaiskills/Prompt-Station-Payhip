# ---------------------------------------------------------------
# Environment variables — copy to .env (local) or set in Netlify
# Site settings → Environment variables before going live.
#
# Nothing here is REQUIRED for the core storefront to work:
# the storefront, Payhip checkout links, and Netlify Forms all run
# without any secrets. These variables only power the optional
# serverless integration points described in docs/PAYHIP_SETUP.md.
# ---------------------------------------------------------------

# Optional — Payhip account API key (Payhip → Settings → Developer tab).
# Powers the /api/payhip-license-verify function (license checking widget).
PAYHIP_API_KEY=

# Optional — shared secret that must appear as ?token=... on Payhip webhook
# calls forwarded to the /api/payhip-webhook function. Set the webhook URL in
# Payhip as:  https://YOUR-SITE.netlify.app/api/payhip-webhook?token=YOUR_PAYHIP_WEBHOOK_SECRET
PAYHIP_WEBHOOK_SECRET=change-me-before-production

# Site URL — must match the production domain for canonical tags & sitemap.
# Set in src/config/site.mjs (SITE.url); optionally mirrored here.
SITE_URL=https://YOUR-STORE.netlify.app
